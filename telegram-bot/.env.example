# Скопируй в .env и заполни своими значениями. Токен бери у @BotFather, не свой личный аккаунт.
TELEGRAM_BOT_TOKEN=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Персона/системный промпт бота — задаёт нишу
BOT_PERSONA="Ты дружелюбный и точный ассистент."
# Сколько бесплатных сообщений даём новому пользователю до пейвола
FREE_MESSAGES=10
