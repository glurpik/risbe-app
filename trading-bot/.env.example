# DeepSeek API (main analysis engine)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Claude API (calibration only, optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Polymarket
POLYMARKET_API_KEY=your_polymarket_api_key
POLYMARKET_SECRET=your_polymarket_secret
POLYMARKET_PASSPHRASE=your_polymarket_passphrase

# Bybit (crypto trading)
BYBIT_API_KEY=your_bybit_api_key
BYBIT_SECRET=your_bybit_secret

# Crypto Wallet (EVM — Ethereum/Polygon, for Polymarket)
WALLET_PRIVATE_KEY=your_private_key_here
RPC_URL=https://polygon-rpc.com

# Bot settings
AUTO_MODE=false
CONFIDENCE_THRESHOLD=0.75
MAX_TRADE_USD=3
NEWS_INTERVAL_MIN=30
